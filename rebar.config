%% -*- mode: Erlang; fill-column: 80; comment-column: 75; -*-

{erl_opts, [
    % mandatory
    debug_info,
    warnings_as_errors,
    warn_export_all,
    warn_missing_spec,
    warn_untyped_record,
    warn_export_vars,

    % by default
    warn_unused_record,
    warn_bif_clash,
    warn_obsolete_guard,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warn_unused_function,
    warn_deprecated_function,

    strict_validation
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions,
    locals_not_used
]}.

{cover_enabled, true}.
{edoc_opts, [{dialyzer_specs, all}]}.
{validate_app_modules, true}.

{project_plugins, []}.

{profiles, [
    {test, [
        {dialyzer, [{plt_extra_apps, [
            eunit,
            runtime_tools
        ]}]}
    ]}
]}.

{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        unknown
    ]},
    {plt_apps, all_deps}
]}.
