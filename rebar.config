%% -*- mode: Erlang; fill-column: 80; comment-column: 75; -*-

{erl_opts, [
    fail_on_warning,
    debug_info,
    warn_untyped_record
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_functions_calls,
    deprecated_functions,
    locals_not_used
]}.

{cover_enabled, true}.
{cover_print_enabled, false}.
{edoc_opts, [{dialyzer_specs, all}]}.
{validate_app_modules, true}.

{project_plugins, []}.

{profiles, [
    {test, [
        {erl_opts, [
            nowarn_export_all
        ]},
        {dialyzer, [{plt_extra_apps, [
            eunit,
            runtime_tools
        ]}]}
    ]}
]}.

{dialyzer, [
    {plt_apps, all_deps}
]}.
